PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/unfazed?replicaSet=rs0
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
FRONTEND_URL=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Seed only a dedicated development database; existing records are preserved.
SEED_DATABASE_ALLOW=false
SEED_PASSWORD=
RAZORPAY_WEBHOOK_SECRET=
# Monetary policy: rates are stored as integer paise; invoice GST is inclusive.
PLATFORM_FEE_BPS=0
GST_BPS=0
BOOKING_HOLD_MINUTES=20
PACKAGE_EXPIRY_DAYS=90
INVOICE_BUSINESS_NAME=Unfazed
INVOICE_ADDRESS=
INVOICE_GSTIN=

NODE_ENV=development
TRUST_PROXY_HOPS=0
# Optional comma-separated exact origins, overrides FRONTEND_URL (no wildcard previews)
FRONTEND_URLS=
# Durable domain-event dispatcher and reminder scan
NOTIFICATION_POLL_MS=10000
# Optional email. WhatsApp is always a persisted stub; no live WhatsApp credentials are used.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
