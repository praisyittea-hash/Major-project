{
  "name": "unfazed",
  "private": true,
  "workspaces": [
    "unfazed-backend",
    "unfazed-frontend"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build -w unfazed-frontend",
    "lint": "npm run lint --workspaces --if-present",
    "dev:api": "npm run dev -w unfazed-backend",
    "dev:web": "npm run dev -w unfazed-frontend",
    "format:check": "prettier --check unfazed-backend unfazed-frontend eslint.config.js docs README.md package.json .prettierrc.json",
    "format": "prettier --write unfazed-backend unfazed-frontend eslint.config.js docs README.md package.json .prettierrc.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  }
}
